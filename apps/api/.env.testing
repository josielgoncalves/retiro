# Loaded automatically instead of .env whenever APP_ENV=testing (i.e. every
# PHPUnit run — see phpunit.xml). This is what keeps the test suite from
# ever touching the development database: Laravel picks this file over
# .env by itself (Illuminate\Foundation\Bootstrap\LoadEnvironmentVariables),
# so there is no env-var precedence to fight, unlike trying to force this
# through phpunit.xml's <env> block.
APP_NAME="Portal do Retiro de Casais"
APP_ENV=testing
APP_KEY=base64:UMnBBkmwinNanjuN9dlnACe5xZdxp/yyHOI0jRiP5HA=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=retiro_casais_testing
DB_USERNAME=retiro_casais
DB_PASSWORD=change-me-please

SESSION_DRIVER=array
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8080

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MAIL_MAILER=array

DEMO_ADMIN_NAME="Administrador"
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-please
