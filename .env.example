# Copy this file to .env and adjust values before running `docker compose up`.
# Never commit the real .env file.

# ---- App ----
APP_NAME="Portal do Retiro de Casais"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

# ---- Database ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=retiro_casais
DB_USERNAME=retiro_casais
DB_PASSWORD=change-me-please

# ---- Ports published to the host ----
NGINX_HTTP_PORT=8080
POSTGRES_HOST_PORT=55432

# ---- Frontend ----
VITE_API_BASE_URL=/api/v1

# ---- Demo admin user (used by `php artisan app:create-admin`) ----
DEMO_ADMIN_NAME="Administrador"
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-please
